---
import Layout from "../../layouts/Layout.astro";
import LegalPageContent from "../../components/templates/LegalPageContent.astro";
import { getDictionary } from "../../i18n/ui";

const locale = "fr" as const;
const t = getDictionary(locale);
---

<Layout
  locale={locale}
  routeKey="cookies"
  title={`${t.legal.cookies.navTitle} — La Finca Oropesa`}
  description="Politique de cookies de La Finca Oropesa."
>
  <LegalPageContent locale={locale} docKey="cookies" />
</Layout>
