---
import Layout from "../../layouts/Layout.astro";
import LegalPageContent from "../../components/templates/LegalPageContent.astro";
import { getDictionary } from "../../i18n/ui";

const locale = "en" as const;
const t = getDictionary(locale);
---

<Layout
  locale={locale}
  routeKey="legal"
  title={`${t.legal.legalNotice.navTitle} — La Finca Oropesa`}
  description="Legal notice for La Finca Oropesa."
>
  <LegalPageContent locale={locale} docKey="legal-notice" />
</Layout>
