---
import "../styles/global.css";
import type { Locale } from "../config/site";
import type { RouteKey } from "../i18n/routes";
import { getDictionary } from "../i18n/ui";
import SEO from "../components/SEO.astro";
import StructuredData from "../components/StructuredData.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Lightbox from "../components/Lightbox.astro";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  title: string;
  description: string;
  ogImage?: string;
  transparentHeader?: boolean;
  includeStructuredData?: boolean;
}
const {
  locale,
  routeKey,
  title,
  description,
  ogImage,
  transparentHeader = false,
  includeStructuredData = false,
} = Astro.props;

const t = getDictionary(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO routeKey={routeKey} locale={locale} title={title} description={description} ogImage={ogImage} />
    {includeStructuredData && <StructuredData locale={locale} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <noscript>
      <style>
        /* Sans JavaScript, reveal.ts ne tourne jamais : le contenu doit rester visible. */
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-chaux focus:p-3">
      {t.nav.skipToContent}
    </a>
    <AnnouncementBar locale={locale} />
    <Header locale={locale} routeKey={routeKey} transparent={transparentHeader} />
    <main id="contenu">
      <slot />
    </main>
    <Footer locale={locale} hideWaitlist={routeKey === "home" || routeKey === "sejourner"} />
    <Lightbox closeLabel={t.lightbox.close} nextLabel={t.lightbox.next} prevLabel={t.lightbox.prev} />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
